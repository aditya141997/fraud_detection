{
 "uid": "fraud-scoring",
 "title": "Fraud scoring: latency, decisions, drift",
 "tags": [
  "fraud-stream"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Scoring latency p50 / p95 / p99 (server-side)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(fraud_score_request_seconds_bucket[1m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_score_request_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(fraud_score_request_seconds_bucket[1m])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.08
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 2,
   "title": "Requests per second",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(fraud_score_request_seconds_count[30s]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 3,
   "title": "Errors / s",
   "type": "timeseries",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(fraud_score_errors_total[1m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 4,
   "title": "Mean time per stage",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (stage) (rate(fraud_score_stage_seconds_sum[1m])) / sum by (stage) (rate(fraud_score_stage_seconds_count[1m]))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 5,
   "title": "Share of transactions flagged",
   "type": "timeseries",
   "gridPos": {
    "x": 8,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(fraud_decisions_total{decision=\"flag\"}[1m])) / sum(rate(fraud_decisions_total[1m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 6,
   "title": "Decisions per second by model version",
   "type": "timeseries",
   "gridPos": {
    "x": 16,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (model_version, decision) (rate(fraud_decisions_total[1m]))",
     "legendFormat": "v{{model_version}} {{decision}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 7,
   "title": "Score distribution (share of requests per bucket)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (le) (rate(fraud_score_value_bucket[2m]))",
     "legendFormat": "le {{le}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 8,
   "title": "Entities with no online features / s",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (entity) (rate(fraud_feature_missing_total[1m]))",
     "legendFormat": "{{entity}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 9,
   "title": "Drifted-column share (alert above 25%)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "fraud_drift_share",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 10,
   "title": "Score drift distance",
   "type": "timeseries",
   "gridPos": {
    "x": 8,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "fraud_score_drift_distance",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "id": 11,
   "title": "Top feature drift distances",
   "type": "timeseries",
   "gridPos": {
    "x": 16,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "topk(10, fraud_feature_drift_distance)",
     "legendFormat": "{{feature}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  }
 ]
}